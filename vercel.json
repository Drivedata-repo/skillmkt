{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{lib/**,certs/**,data/**,views/**,dist/navigation.js,dist/card-identity.js,dist/evidence-assets/**}"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/api/app" },
    { "source": "/login", "destination": "/acesso.html" },
    { "source": "/acesso", "destination": "/acesso.html" },
    { "source": "/oferta", "destination": "/oferta.html" },
    { "source": "/loja", "destination": "/loja.html" },
    { "source": "/api/webhooks/hotmart", "destination": "/api/commerce?route=webhook" },
    { "source": "/api/webhooks/stripe", "destination": "/api/commerce?route=stripe-webhook" },
    { "source": "/api/account/:route", "destination": "/api/commerce?route=:route" },
    { "source": "/api/nexo", "destination": "/api/triage?route=chat" },
    { "source": "/privacidade", "destination": "/privacy.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/oferta",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https: blob:; font-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://pay.hotmart.com"
        }
      ]
    }
  ]
}
