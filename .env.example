# Server-only. Use the scoped skillmkt_app role, never browser-exposed variables.
DATABASE_URL=postgresql://skillmkt_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
RATE_LIMIT_SECRET=replace-with-32-random-bytes
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Separate administrator key for aggregate feedback metrics, at least 32 characters.
INSIGHTS_KEY=
# Venda. Somente no servidor.
HOTMART_HOTTOK=
HOTMART_PRODUCT_MAP=
CUSTOMER_SESSION_SECRET=replace-with-32-random-bytes
# Envio do link de criar senha (Resend).
MAIL_API_KEY=
MAIL_FROM=
PUBLIC_URL=https://deck.drivedata.com.br
# Pagamento (Stripe). Chave restrita, sem saque. Somente no servidor.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true liga o cálculo de imposto do Stripe (exige Stripe Tax configurado).
STRIPE_AUTOMATIC_TAX=false
# Dólar para real no Brasil: PTAX do Banco Central. Margem em % (0 a 20) e cotação fixa de emergência.
BRL_MARGIN_PERCENT=0
USD_BRL_RATE=
